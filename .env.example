# Copy this file to .env for local development:
#   cp .env.example .env

# SQLite database path
DATABASE_URL="file:./prisma/dev.db"

# Directory where task workspaces (cloned repos) are stored
WORKSPACES_PATH=/tmp/claude-task-manager-workspaces

# Directory containing the claude binary, if not already on your PATH
# Example: CLAUDE_PATH=/home/youruser/.local/bin
CLAUDE_PATH=

# Email is set up in Settings → Notifications → Email delivery (SMTP or Amazon SES).
# Only needed for Amazon SES with "From the server environment" credentials:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=

# Slack integration (optional). Usually configured in Settings → Integrations instead.
# Uncomment only with real tokens: placeholder values make the bot try to connect.
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_APP_TOKEN=xapp-...

# User monitoring (ObiStack) is opt-in from Settings → Observability, not configured here.
